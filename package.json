{
  "name": "kamino",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "doctor:web": "bunx react-doctor@latest ./apps/web --scope changed --lint --verbose",
    "doctor:ui": "bunx react-doctor@latest ./packages/ui --scope changed --lint --verbose",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "typecheck:stable": "turbo typecheck:stable",
    "test": "turbo test",
    "ci": "bash scripts/ci.sh"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=24.15.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "turbo": "^2.11.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0",
    "web": "workspace:*"
  },
  "overrides": {
    "fast-uri": ">=3.1.2",
    "hono": ">=4.12.25"
  }
}
